## Build pan-calicoblast centroid

Each species' embeddings are **centred independently** before extracting
calicoblast cells, so that species-level global biases do not contaminate the
pan-calicoblast signal.

```{r pan-calicoblast}
centre <- function(emb) sweep(emb, 2, colMeans(emb))
l2_norm_vec <- function(v) v / sqrt(sum(v^2))

# Centre each species, then collect calicoblast cells
cali_sources <- list(
  Amil = list(emb = emb_amil, ct = ct_amil_m),
  Spis = list(emb = emb_spis, ct = ct_spis_m),
  Ocup = list(emb = emb_ocup, ct = ct_ocup_m),
  Gast = list(emb = emb_gast, ct = ct_gast_m)
)

cali_pool <- do.call(rbind, lapply(names(cali_sources), function(sp) {
  d   <- cali_sources[[sp]]
  emb_c <- centre(d$emb)
  n_cali <- sum(d$ct == "calicoblast")
  cat(sprintf("%-5s : %d calicoblast cells\n", sp, n_cali))
  emb_c[d$ct == "calicoblast", , drop = FALSE]
}))

cat(sprintf("\nTotal pooled calicoblast cells: %d\n", nrow(cali_pool)))

# Pan-calicoblast centroid: mean of all pooled cells, L2-normalised
pan_cali_centroid <- l2_norm_vec(colMeans(cali_pool))
```

## Helper: cell-type centroids for comparison species

```{r helpers}
mean_by_type_normed <- function(emb, labels) {
  emb_c <- centre(emb)
  types <- sort(unique(labels))
  mat <- do.call(rbind, lapply(types, function(ct)
    l2_norm_vec(colMeans(emb_c[labels == ct, , drop = FALSE]))))
  rownames(mat) <- types
  mat
}

# Species order: distant (no calicoblast) → close (has calicoblast)
comp_order <- c("Xsp", "Nve", "Ryuma", "Spis", "Ocup", "Gast", "Amil")
has_calicoblast <- c(Amil=TRUE, Spis=TRUE, Ocup=TRUE, Gast=TRUE,
                     Ryuma=FALSE, Xsp=FALSE, Nve=FALSE)

comp_centroids <- list(
  Amil  = mean_by_type_normed(emb_amil,  ct_amil_m),
  Spis  = mean_by_type_normed(emb_spis,  ct_spis_m),
  Ocup  = mean_by_type_normed(emb_ocup,  ct_ocup_m),
  Gast  = mean_by_type_normed(emb_gast,  ct_gast_m),
  Ryuma = mean_by_type_normed(emb_ryuma, ct_ryuma_m),
  Xsp   = mean_by_type_normed(emb_xsp,   ct_xsp_m),
  Nve   = mean_by_type_normed(emb_nve,   ct_nve_m)
)
```

## Cosine similarity: pan-calicoblast vs. each species

```{r compute-sim}
sim_df <- do.call(rbind, lapply(comp_order, function(sp) {
  centroids <- comp_centroids[[sp]]
  sims      <- as.numeric(centroids %*% pan_cali_centroid)
  data.frame(
    species    = sp,
    cell_type  = rownames(centroids),
    similarity = sims,
    is_cali    = rownames(centroids) == "calicoblast",
    has_cali   = has_calicoblast[sp],
    stringsAsFactors = FALSE
  )
}))

sim_df$species <- factor(sim_df$species, levels = comp_order)
```

## Visualisation

### Bar plots: pan-calicoblast similarity per species

```{r barplots, fig.width = 12, fig.height = 7}
ggplot(sim_df,
       aes(x = reorder(cell_type, similarity), y = similarity, fill = is_cali)) +
  geom_col() +
  geom_hline(yintercept = 0, linewidth = 0.3, colour = "grey40") +
  scale_fill_manual(values = c("FALSE" = "steelblue", "TRUE" = "firebrick"),
                    labels = c("FALSE" = "other", "TRUE" = "calicoblast"),
                    name = "Cell type") +
  facet_wrap(~ species, nrow = 2, scales = "free_x") +
  coord_flip() +
  labs(x = NULL, y = "Cosine similarity to pan-calicoblast centroid",
       title = "Pan-calicoblast cosine similarity vs. each cell type",
       subtitle = "Species order: Scleractinia → Corallimorpharia → Octocorallia → Actiniaria\nRed = calicoblast (if annotated in that species)") +
  theme_classic(base_size = 11) +
  theme(strip.background = element_blank(),
        strip.text = element_text(face = "bold"))
```

### Heatmap: all species × merged cell types

```{r heatmap, fig.width = 10, fig.height = 5}
merged_type_order <- c(
  "calicoblast", "epidermis", "gastrodermis", "alga_hosting_cell",
  "digestive_filaments", "glands", "immune_cell", "cnidocyte",
  "neuron", "germline", "unknown"
)

# Long-format data for ggplot heatmap
heat_df <- do.call(rbind, lapply(comp_order, function(sp) {
  d <- sim_df[sim_df$species == sp, ]
  data.frame(
    species   = sp,
    cell_type = merged_type_order,
    similarity = heat_mat[sp, merged_type_order],   # NA if absent
    stringsAsFactors = FALSE
  )
}))

# Build the full matrix for NA lookup (constructed above in the loop)
heat_mat <- matrix(
  NA_real_,
  nrow = length(comp_order),
  ncol = length(merged_type_order),
  dimnames = list(comp_order, merged_type_order)
)
for (sp in comp_order) {
  d <- sim_df[sim_df$species == sp, ]
  present <- intersect(d$cell_type, merged_type_order)
  heat_mat[sp, present] <- d$similarity[match(present, d$cell_type)]
}

heat_df <- do.call(rbind, lapply(comp_order, function(sp) {
  data.frame(
    species    = sp,
    cell_type  = merged_type_order,
    similarity = heat_mat[sp, merged_type_order],
    stringsAsFactors = FALSE
  )
}))
heat_df$species   <- factor(heat_df$species,   levels = comp_order)
heat_df$cell_type <- factor(heat_df$cell_type, levels = merged_type_order)
heat_df$is_na     <- is.na(heat_df$similarity)

# Species row label: mark those with calicoblast
sp_label_map <- setNames(
  ifelse(has_calicoblast[comp_order], paste0(comp_order, "*"), comp_order),
  comp_order
)
heat_df$sp_label <- factor(sp_label_map[as.character(heat_df$species)],
                            levels = sp_label_map[comp_order])

ggplot(heat_df, aes(x = cell_type, y = sp_label)) +
  geom_tile(aes(fill = similarity), colour = "white", linewidth = 0.5) +
#  geom_text(data = heat_df[!heat_df$is_na, ],
#            aes(label = sprintf("%.2f", similarity)),
#            size = 2.8, colour = "black") +
  scale_fill_gradientn(
    colours = colorRampPalette(c("navy", "white", "firebrick"))(100),
    limits  = c(-0.4, 0.4), oob = scales::squish,
    name    = "Cosine\nsimilarity", na.value = "grey"
  ) +
  scale_x_discrete(position = "top") +
  labs(x = NULL, y = NULL,
       title = "Pan-calicoblast cosine similarity",
       subtitle = "* = species has calicoblast annotation") +
  theme_classic(base_size = 11) +
  theme(axis.text.x = element_text(angle = 90, hjust = 0),
        axis.ticks   = element_blank(),
        panel.border = element_rect(colour = "grey", fill = NA))
```

